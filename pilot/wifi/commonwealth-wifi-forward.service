[Unit]
Description=Commonwealth dedicated edge IPv4 forwarding
Requires=commonwealth-wifi-guard.service
After=commonwealth-wifi-guard.service
BindsTo=commonwealth-wifi-guard.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/sysctl -qw net.ipv4.ip_forward=1
ExecStop=/usr/sbin/sysctl -qw net.ipv4.ip_forward=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
